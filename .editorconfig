root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 120

[*.{sh,bash,nix,lua}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{tsv,jsonl}]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
